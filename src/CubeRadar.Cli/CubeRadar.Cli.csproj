<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- tools\package.ps1 builds the shared "Cube Radar.exe" as a Windows app without a console window. -->
    <OutputType Condition="'$(CubeRadarWindowsApp)' == 'true'">WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>cuberadar</AssemblyName>
    <Version>0.8.2</Version>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>..\..\assets\cuberadar.ico</ApplicationIcon>
    <Product>Cube Radar</Product>
    <AssemblyTitle>Cube Radar</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only used by the overlay; keep its names (Orientation, Timer, …) out of the global namespace. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\CubeRadar.Core\CubeRadar.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The single "Cube Radar.exe" carries the web UI and the default config inside (see AppPaths). -->
    <EmbeddedResource Include="wwwroot\**" LogicalName="wwwroot/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\config\*.json" LogicalName="config/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
